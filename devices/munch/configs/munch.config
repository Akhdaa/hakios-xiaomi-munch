# HakiOS fragment: the POCO F4 (munch) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="munch"
CONFIG_HAKIOS_ADSP=y
CONFIG_HAKIOS_SPEAKER=y
CONFIG_HAKIOS_SOUND=y
CONFIG_HAKIOS_MIC=y
# CONFIG_HAKIOS_BT is not set
CONFIG_HAKIOS_CAMERA=y
# CONFIG_HAKIOS_TORCH is not set
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_ADRENO=y
CONFIG_HAKIOS_HAPTIC=y
# CONFIG_HAKIOS_GOODIX is not set
CONFIG_HAKIOS_BUTTONS=y
CONFIG_HAKIOS_QMI=y
# CONFIG_HAKIOS_MODEM is not set
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_PMIC=y
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_UFS is not set
CONFIG_HAKIOS_WIFI=y
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_FIRMWARE is "device" in the common kernel: say "none" here until this device's firmware is pulled
# Nothing of this phone's storage is read or written by the kernel: the system comes over USB into RAM, and the UFS
# block service of the common kernel (ufs=2) stays off here.
# CONFIG_UFS is not set
# the cores and their clocks: the prime core at most 2800 MHz (2745.6 is the row), back to 2361.6 from thermal_slow (90 degrees)
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_CPUFREQ=y
CONFIG_THERMAL=y
CONFIG_PMIC=y
# the touch screen (devices/munch/drivers/input: the FT3658U) and the PM8150's keys, which start with it
CONFIG_HAKIOS_MUNCH_TOUCH=y
CONFIG_HAKIOS_MUNCH_PANEL=y
CONFIG_HAKIOS_MUNCH_MODEM=y
CONFIG_HAKIOS_MUNCH_CAMERA=y
CONFIG_HAKIOS_MUNCH_TORCH=y
CONFIG_TOUCHSCREEN=y
# the chip's identity from SMEM (soc_smem in soc.args): read only
CONFIG_SOCINFO=y
# the audio DSP, the speakers through the TFA9874s at 96 kHz, and the fuel gauge (fw-audio/: adsp.*, tfa98xx.cnt)
CONFIG_HAKIOS_MUNCH_AMP=y
CONFIG_HAKIOS_MUNCH_BATTERY=y
CONFIG_ADSP=y
CONFIG_SOUND=4
# the fuel gauge's own guard (hakios.munch_battery.c) ends the run at 15% with the charge going out: on a computer's port this
# phone discharges with the cable in, and hakios.battguard.c, which waits while a charger is attached, would never act
CONFIG_BATTERY=y
CONFIG_BATTERY_STOP=15
# the Wi-Fi: the QCA6390 on PCIe 0 (devices/munch/drivers/wifi) under ath11k (tools/mk-ath11k.sh), fw-wifi/
CONFIG_HAKIOS_MUNCH_WIFI=y
CONFIG_HAKIOS_MUNCH_BT=y
CONFIG_WIFI=y
# the vibration motor: the AW86927 on QUP 2's serial engine 15 (haptic=5, fw-haptic/aw8697_haptic.bin)
CONFIG_HAPTIC=5
# the glass: the camera's hole kept black (Android's: 23 around 540, 52); the corners are left as they are, which looked
# better on the phone than any black over them
CONFIG_FB_HOLE=23
# icons black while a list was scrolled fast: every surface out of the cache at every submission (6 November)
CONFIG_GPU_PUSH_MS=0
# the panel's own brightness over DSI (devices/munch/drivers/display): a readable level at the start, not 2047
CONFIG_PANEL=2
CONFIG_PANEL_LEVEL=300
# the window server drawn by the Adreno through Mesa (gpu=1)
CONFIG_GPU=y
# the flashlight is Darwin's (Control Center): /dev/hakios-torch; it goes through mediaserverd's camera device, which is
# there when the kernel has a camera -- until the sensors' frames come, cam_fake's chart
CONFIG_MUNCH_TORCH=3
CONFIG_CAM=5
CONFIG_CAM_FAKE=1
